---
import "@/features/ai-engineering/finch-showcase.scss";
import { finchShowcaseData } from "@/features/ai-engineering/data/finchData";

const { badge, title, projectTitle, lead, description, cta, metrics, quickTimeline } =
  finchShowcaseData;
---

<section class="ai-eng__wrapper" aria-labelledby="ai-eng-title">
  <header class="ai-eng__header">
    <div class="ai-eng__badge-wrap">
      <span class="ai-eng__pulse" aria-hidden="true"></span>
      <span class="ai-eng__badge-text">{badge}</span>
    </div>
    <h2 id="ai-eng-title" class="ai-eng__title-h2">{title}</h2>
  </header>

  <article class="ai-eng__card">
    <div class="ai-eng__inner">
      <!-- Fila Superior: Narrativa de Ingeniería + Mini Esfera / Grafo Decorativo -->
      <div class="ai-eng__top-grid">
        <div class="ai-eng__narrative">
          <div class="ai-eng__kicker">
            <span class="ai-eng__kicker-code">PROPRIETARY R&D · MCP ENGINE</span>
            <span class="ai-eng__kicker-version">v2.2 ACTIVE</span>
          </div>

          <h3 class="ai-eng__project-title">{projectTitle}</h3>
          <p class="ai-eng__lead">{lead}</p>
          <p class="ai-eng__desc">{description}</p>

          <!-- Evolución resumida v1.0 -> v2.0 -> v2.2 -->
          <div class="ai-eng__evo" aria-label="Evolución de versiones de Finch">
            {
              quickTimeline.map((step) => (
                <div class="ai-eng__evo-item">
                  <div class="ai-eng__evo-head">
                    <span class="ai-eng__evo-ver">{step.version}</span>
                    <strong class="ai-eng__evo-name">{step.name}</strong>
                  </div>
                  <p class="ai-eng__evo-desc">{step.desc}</p>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Columna Derecha: Orbe Sináptico SVG + Acción Principal hacia /finch -->
        <div class="ai-eng__visual-col">
          <a
            href={cta.href}
            class="ai-eng__orb-preview"
            aria-label="Ver animación 3D de la Esfera Sináptica de Finch y leer el caso de estudio"
          >
            <div class="ai-eng__orb-glow" aria-hidden="true"></div>
            <svg
              class="ai-eng__orb-svg"
              viewBox="0 0 260 260"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <!-- Anillos orbitales color hueso -->
              <circle
                cx="130"
                cy="130"
                r="102"
                stroke="currentColor"
                stroke-opacity="0.22"
                stroke-width="1"
                stroke-dasharray="4 6"
              />
              <ellipse
                cx="130"
                cy="130"
                rx="102"
                ry="46"
                transform="rotate(-28 130 130)"
                stroke="currentColor"
                stroke-opacity="0.28"
                stroke-width="1.1"
              />
              <ellipse
                cx="130"
                cy="130"
                rx="102"
                ry="46"
                transform="rotate(32 130 130)"
                stroke="currentColor"
                stroke-opacity="0.28"
                stroke-width="1.1"
              />
              <ellipse
                cx="130"
                cy="130"
                rx="74"
                ry="98"
                transform="rotate(12 130 130)"
                stroke="currentColor"
                stroke-opacity="0.2"
                stroke-width="1"
              />
              <!-- Conexiones sinápticas internas (color hueso) -->
              <g stroke="currentColor" stroke-opacity="0.38" stroke-width="1.1">
                <line x1="68" y1="88" x2="130" y2="62" />
                <line x1="130" y1="62" x2="192" y2="90" />
                <line x1="68" y1="88" x2="108" y2="130" />
                <line x1="192" y1="90" x2="154" y2="130" />
                <line x1="108" y1="130" x2="154" y2="130" />
                <line x1="108" y1="130" x2="82" y2="178" />
                <line x1="154" y1="130" x2="178" y2="176" />
                <line x1="82" y1="178" x2="130" y2="198" />
                <line x1="178" y1="176" x2="130" y2="198" />
                <line x1="130" y1="62" x2="130" y2="198" />
              </g>
              <!-- Nodos Cian (Color de la "S" del logo: #00E5FF / #67E8F9) -->
              <g class="ai-eng__orb-nodes">
                <circle cx="130" cy="62" r="4.5" fill="#00E5FF" />
                <circle cx="68" cy="88" r="4" fill="#67E8F9" />
                <circle cx="192" cy="90" r="4.5" fill="#00E5FF" />
                <circle cx="108" cy="130" r="5.5" fill="#00E5FF" />
                <circle cx="154" cy="130" r="5" fill="#67E8F9" />
                <circle cx="82" cy="178" r="4" fill="#00E5FF" />
                <circle cx="178" cy="176" r="4.5" fill="#67E8F9" />
                <circle cx="130" cy="198" r="4.5" fill="#00E5FF" />
                <circle cx="44" cy="134" r="3.2" fill="#0284C7" />
                <circle cx="216" cy="128" r="3.2" fill="#0284C7" />
              </g>
            </svg>
            <div class="ai-eng__orb-overlay">
              <span class="ai-eng__orb-title">FINCH</span>
              <span class="ai-eng__orb-tag">WEBGL 3D · 64-D HYPERSPHERE</span>
            </div>
          </a>

          <a href={cta.href} class="ai-eng__cta-btn" aria-label={cta.ariaLabel}>
            <span>{cta.label}</span>
            <span class="ai-eng__cta-arrow" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                width="18"
                height="18"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M5 12h14M13 5l7 7-7 7"></path>
              </svg>
            </span>
          </a>
        </div>
      </div>

      <!-- Fila Inferior: 4 Métricas Cuantitativas de Ingeniería -->
      <ul class="ai-eng__metrics" role="list" aria-label="Métricas de rendimiento de Finch">
        {
          metrics.map((m) => (
            <li class="ai-eng__metric-card">
              <span class="ai-eng__metric-val">{m.value}</span>
              <strong class="ai-eng__metric-label">{m.label}</strong>
              <span class="ai-eng__metric-detail">{m.detail}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </article>
</section>
