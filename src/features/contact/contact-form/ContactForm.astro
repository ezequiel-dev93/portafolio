---
import "@/features/contact/contact-form/contact-form.scss";
---

<section class="contact" aria-label="Formulario de contacto">
  <form class="contact__form" id="form" novalidate>
    <div class="contact__form-group">
      <label for="name" class="visually-hidden">Nombre completo o nombre de la empresa</label>
      <input
        type="text"
        name="name"
        id="name"
        autocomplete="name"
        placeholder="Nombre Completo o Nombre De La Empresa"
        class="contact__input"
        required
        aria-describedby="name-error"
        aria-invalid="false"
      />
      <p
        id="name-error"
        class="contact__message"
        aria-live="polite"
      >
      </p>
    </div>

    <div class="contact__form-group">
      <label for="email" class="visually-hidden">Tu correo electrónico</label>
      <input
        type="email"
        name="email"
        id="email"
        autocomplete="email"
        placeholder="Tu Correo Electrónico"
        class="contact__input"
        required
        aria-describedby="email-error"
        aria-invalid="false"
      />
      <p
        id="email-error"
        class="contact__message"
        aria-live="polite"
      >
      </p>
    </div>

    <div class="contact__form-group">
      <label for="message" class="visually-hidden">Cuéntame sobre tu proyecto</label>
      <textarea
        name="message"
        id="message"
        placeholder="Cuéntame Sobre Tu Proyecto"
        class="contact__textarea"
        required
        aria-describedby="message-error"
        aria-invalid="false"></textarea>
      <p
        id="message-error"
        class="contact__message"
        aria-live="polite"
      >
      </p>
    </div>

    <div class="contact__honeypot" aria-hidden="true" tabindex="-1">
      <label for="honeypot">No llenar este campo</label>
      <input type="text" id="honeypot" name="honeypot" tabindex="-1" autocomplete="off" />
    </div>

    <div class="contact__form-group">
      <button type="submit" id="button" class="contact__button">Enviar</button>
    </div>
  </form>

  <script
    is:inline
    type="text/javascript"
    src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"
  ></script>
  <script is:inline type="text/javascript">
    if (window.emailjs) {
      window.emailjs.init("miYrSPp0_92YF1RLW");
    }
  </script>
</section>

<script>
  import { initContactFormValidation } from "@/utils/validation";

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initContactFormValidation, {
      once: true,
    });
  } else {
    initContactFormValidation();
  }

  document.addEventListener("astro:page-load", initContactFormValidation);
</script>
