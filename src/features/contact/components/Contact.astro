---
import "@/features/contact/contact.scss";
import contactData from "@/features/contact/data/contact";

const { title, lead, description, cta } = contactData;
---

<section class="contactCta" aria-labelledby="contact-cta-title">
  <header class="contactCta__header">
    <h2 id="contact-cta-title" class="contactCta__title">{title}</h2>
  </header>

  <div class="contactCta__card">
    <div class="contactCta__inner">
      <div class="contactCta__content">
        <h3 class="contactCta__lead">{lead}</h3>

        <p class="contactCta__text">{description}</p>
      </div>

      <div class="contactCta__actions">
        <a
          href={cta.href}
          class="contactCta__btn"
          aria-label={cta.ariaLabel}
        >
          <span class="contactCta__btn-label">{cta.label}</span>
          <span class="contactCta__btn-icon" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M5 12h14M13 5l7 7-7 7"></path>
            </svg>
          </span>
        </a>
      </div>
    </div>
  </div>
</section>
