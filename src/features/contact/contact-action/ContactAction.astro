---
import '@/features/contact/contact-action/contact-action.scss';
import EmailIcon from "@/shared/icons/Email.astro";
import CopyIcon from "@/shared/icons/Copy.astro";
---

<section class="contact" aria-labelledby="contact-action-title">
  <section class="contact__container">
    <h3 id="contact-action-title" class="contact__container-title">Puedes contactarme con un click</h3>
    
    <article class="contact__actions">
      <div>
        <a
          href="mailto:ezequielsuarez.dev@gmail.com"
          class="contact__actions-buttom contact__button--email"
          aria-label="Abrir correo electrónico"
          data-contact-hover="Abre tu aplicación de correo"
        >
          <EmailIcon class="contact__icon" aria-hidden="true"/>
        </a>    
      </div>

      <div>
        <button
          type="button"
          class="contact__actions-buttom contact__button--copy"
          aria-label="Copiar dirección de correo"
          data-contact-hover="Copia mi dirección de correo"
          data-contact-copy="ezequielsuarez.dev@gmail.com"
        >
          <CopyIcon class="contact__icon" aria-hidden="true"/>
        </button>
      </div>
    </article>

    <div class="contact__message" aria-live="polite">
      <span id="contact__message-sub">Envíame un correo</span><br>      
      <span id="contact__message-main">Estoy listo para escuchar tus ideas.</span>
    </div>
  </section>  
</section>

<script>
  import { toast } from "@/utils/toast";

  function initContactAction() {
    const mainMsg = document.getElementById("contact__message-main");
    const defaultMainText = "Estoy listo para escuchar tus ideas.";

    const hoverButtons = document.querySelectorAll<HTMLElement>("[data-contact-hover]");
    hoverButtons.forEach((btn) => {
      if (btn.dataset.hoverBound === "true") return;
      btn.dataset.hoverBound = "true";

      const hoverText = btn.getAttribute("data-contact-hover") || defaultMainText;
      const setMsg = () => {
        if (mainMsg) mainMsg.textContent = hoverText;
      };
      const resetMsg = () => {
        if (mainMsg) mainMsg.textContent = defaultMainText;
      };

      btn.addEventListener("mouseenter", setMsg);
      btn.addEventListener("mouseleave", resetMsg);
      btn.addEventListener("focus", setMsg);
      btn.addEventListener("blur", resetMsg);
    });

    const copyBtn = document.querySelector<HTMLButtonElement>("[data-contact-copy]");
    if (copyBtn && copyBtn.dataset.copyActionBound !== "true") {
      copyBtn.dataset.copyActionBound = "true";
      copyBtn.addEventListener("click", async () => {
        const email = copyBtn.getAttribute("data-contact-copy") || "ezequielsuarez.dev@gmail.com";
        try {
          await navigator.clipboard.writeText(email);
          if (mainMsg) mainMsg.textContent = "Correo copiado al portapapeles";
          toast.success(
            "¡Correo copiado!",
            `La dirección ${email} ya está en tu portapapeles.`,
            "contact-copy-email",
            3200
          );
          setTimeout(() => {
            if (mainMsg) mainMsg.textContent = defaultMainText;
          }, 2200);
        } catch {
          window.location.href = `mailto:${email}`;
        }
      });
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initContactAction, { once: true });
  } else {
    initContactAction();
  }
  document.addEventListener("astro:page-load", initContactAction);
</script>
