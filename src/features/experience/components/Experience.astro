---
import "@/features/experience/experience.scss";
import { experience } from "@/features/experience/data/experience";
import ShowMore from "@/shared/components/ShowMore.astro";
import ExperienceItem from "@/features/experience/components/ExperienceItem.astro";

const VISIBLE_COUNT = 2;
const visibleItems = experience.slice(0, VISIBLE_COUNT);
const hiddenItems = experience.slice(VISIBLE_COUNT);
---

<ShowMore id="experience" limit={VISIBLE_COUNT}>
  <ul class="experience-card">
    {visibleItems.map((exp) => <ExperienceItem exp={exp} />)}

    {
      hiddenItems.length > 0 && (
        <div class="show-more__hidden" id="show-more-experience">
          {hiddenItems.map((exp) => (
            <ExperienceItem exp={exp} />
          ))}
        </div>
      )
    }
  </ul>
</ShowMore>
