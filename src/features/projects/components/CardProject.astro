---
import '@/features/projects/card-project.scss';
import projects from '@/features/projects/data/projects';  
import ShowMore from '@/shared/components/ShowMore.astro';
import ProjectItem from './ProjectItem.astro';

const VISIBLE_COUNT = 3;
const visibleProjects = projects.slice(0, VISIBLE_COUNT);
const hiddenProjects = projects.slice(VISIBLE_COUNT);
--- 
 
<section class="projects__container" aria-labelledby="projects-title">
  <ShowMore id="projects" limit={VISIBLE_COUNT}>
    <ul class="projects__items">
      {visibleProjects.map((project) => <ProjectItem project={project} />)}

      {hiddenProjects.length > 0 && (
        <li class="show-more__hidden projects__hidden-wrap" id="show-more-projects">
          <ul class="projects__items projects__items--hidden">
            {hiddenProjects.map((project) => <ProjectItem project={project} />)}
          </ul>
        </li>
      )}
    </ul>
  </ShowMore>
</section>
