---
import type { Project, TagKey } from '@/features/projects/types/projects';
import ActionIcon from '@/shared/components/ActionIcon.astro';
import Github from '@/shared/icons/Github.astro';
import Vite from '@/shared/icons/Vite.astro';
import AstroIcon from '@/shared/icons/AstroIcon.astro';
import Tailwind from '@/shared/icons/Tailwind.astro';
import React from '@/shared/icons/React.astro';
import TypeScript from '@/shared/icons/TypeScript.astro';
import Python from '@/shared/icons/Python.astro';
import Pydantic from '@/shared/icons/Pydantic.astro';
import Streamlit from '@/shared/icons/Streamlit.astro';
import Playwright from '@/shared/icons/Playwright.astro';
import Polars from '@/shared/icons/Polars.astro';
import Supabase from '@/shared/icons/Supabase.astro';
import AWS from '@/shared/icons/AmazonWebServices.astro';
import PostgreSQL from '@/shared/icons/PostgreSQL.astro';
import SQLite from '@/shared/icons/SQLite.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, description, tags, github, web, link, isPrivate } = project;

const githubUrl = github || link;
const primaryUrl = web || githubUrl;

const TAGS: Record<TagKey, { icon: any; label: string }> = {
  PYTHON:     { icon: Python, label: 'Python' },
  PYDANTIC:   { icon: Pydantic, label: 'Pydantic' },
  STREAMLIT:  { icon: Streamlit, label: 'Streamlit' },
  PLAYWRIGHT: { icon: Playwright, label: 'Playwright' },
  POLARS:     { icon: Polars, label: 'Polars' },
  VITE:       { icon: Vite, label: 'Vite' },
  TAILWIND:   { icon: Tailwind, label: 'Tailwind CSS' },
  TYPESCRIPT: { icon: TypeScript, label: 'TypeScript' },
  REACT:      { icon: React, label: 'React' },
  NAVE:       { icon: AstroIcon, label: 'Astro' },
  SUPABASE:   { icon: Supabase, label: 'Supabase' },
  AWS:        { icon: AWS, label: 'AWS' },
  POSTGRESQL: { icon: PostgreSQL, label: 'PostgreSQL' },
  SQLITE:     { icon: SQLite, label: 'SQLite' },
};
---

<li class="projects__cards">
  <article class="projects__card-body">
    <div class="projects__links" role="group" aria-label={`Enlaces de ${title}`}>
      {isPrivate ? (
        <div class="projects__private-wrapper">
          <div
            class="action-icon projects__action-btn projects__action-btn--private"
            role="status"
            aria-label={`Repositorio privado de ${title}`}
            tabindex="0"
          >
            <Github width="18" height="18" />
            <span class="projects__private-lock-badge" aria-hidden="true">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="11"
                height="11"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              </svg>
            </span>
          </div>
          <span class="projects__private-tooltip" aria-hidden="true">
            🔒 Repositorio privado
          </span>
        </div>
      ) : (
        githubUrl && (
          <ActionIcon
            icon="github"
            href={githubUrl}
            class="projects__action-btn"
            label={`Ver código en GitHub de ${title}`}
            title="Ver código en GitHub"
          />
        )
      )}

      {web && (
        <ActionIcon
          icon="web"
          href={web}
          class="projects__action-btn projects__action-btn--web"
          label={`Visitar sitio web de ${title}`}
          title="Visitar sitio web"
        />
      )}
    </div>

    <figure class="projects__figure">
      <figcaption class="projects__figure-caption">
        <h3 class="projects__figure-title">
          {primaryUrl ? (
            <a
              href={primaryUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="projects__primary-link"
            >
              {title}
            </a>
          ) : (
            title
          )}
        </h3>

        <p class="projects__figure-description">{description}</p>

        <div class="projects__figure-icons" role="group" aria-label="Tecnologías usadas">
          {tags.map((tag) => {
            const tagItem = TAGS[tag as TagKey];
            if (!tagItem) return null;
            const Icon = tagItem.icon;
            return (
              <span class="projects__tag-wrapper" title={tagItem.label}>
                <Icon
                  class="projects__figure-icon"
                  role="img"
                  aria-label={tagItem.label}
                />
                <span class="projects__tag-tooltip" aria-hidden="true">
                  {tagItem.label}
                </span>
              </span>
            );
          })}
        </div>
      </figcaption>
    </figure>
  </article>
</li>
