---
import '@/styles/app.scss';
import Moon from '@/shared/icons/Moon.astro'
import Sun from '@/shared/icons/Sun.astro'
---

<button
  class="mode-dark mode-dark-btn"
  aria-label="Alternar modo de color"
  aria-pressed="false"
  type="button"
>
  <span class="mode-dark__icon-wrap" aria-hidden="true">
    <span class="mode-dark__icon mode-dark__icon--sun"><Sun /></span>
    <span class="mode-dark__icon mode-dark__icon--moon"><Moon /></span>
  </span>
</button>

<style>
  /* Reset button styles, preserve visual toggle */
  .mode-dark {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    border-radius: 1rem;
  }
</style>