---
const currentYear = new Date().getFullYear();
const { class: className = "" } = Astro.props;
---

<p class={`copyright ${className}`}>
  <span>© {currentYear} Todos los derechos reservados</span>
  <span class="copyright__separator">|</span>
  <span>Ezequiel Suarez</span>
</p>

<style lang="scss">
  @use "styles/abstracts/_variables" as v;

  .copyright {
    font-size: 0.9rem;
    opacity: 0.65;
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: wrap;

    &__separator {
      opacity: 0.5;
    }
  }
</style>
