---
import "@/styles/app.scss";
import "@/layouts/Layout.astro";
import CardProfile from "@/features/profile/card-profile/components/CardProfile.astro";
---

<section class="hero" id="top">
  <canvas id="hero-scene" aria-hidden="true"></canvas>

  <section class="hero__content">
    <CardProfile />
  </section>
</section>

<script>
  function initHeroScene() {
    import("@/lib/hero-animation.js").then(({ initHero }) => initHero());
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHeroScene, { once: true });
  } else {
    initHeroScene();
  }

  document.addEventListener("astro:page-load", initHeroScene);
</script>
