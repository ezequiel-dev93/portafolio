---
import '@/shared/components/show-more.scss';

interface Props {
  /** Unique ID for this show-more group */
  id: string;
  /** Number of items to show initially */
  limit: number;
  /** Button text when collapsed */
  showText?: string;
  /** Button text when expanded */
  hideText?: string;
}

const {
  id,
  limit,
  showText = 'Ver más',
  hideText = 'Ver menos',
} = Astro.props;
---

<div
  class="show-more"
  data-show-more={id}
  data-limit={limit}
  data-show-text={showText}
  data-hide-text={hideText}
>
  <div class="show-more__content">
    <slot />
  </div>

  <button
    class="show-more__btn"
    type="button"
    aria-expanded="false"
    aria-controls={`show-more-${id}`}
  >
    <span class="show-more__btn-text">{showText}</span>
    <svg
      class="show-more__btn-icon"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </button>
</div>
