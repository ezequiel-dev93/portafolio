---
import Layout from "@/layouts/Layout.astro";
---

<Layout
    title="¡Error 404! | Página no encontrada — Ezequiel Suarez"
    description="La página que buscás no existe. Volvé al portfolio de Ezequiel Suarez, Desarrollador de Software."
    canonicalUrl="https://www.ezequielsuarez-dev.com/"
>
    <section class="not-found">
        <div class="not-found__scanlines" aria-hidden="true"></div>

        <div class="not-found__container">
            <div class="not-found__glitch-wrapper" aria-hidden="true">
                <span class="not-found__glitch" data-text="404">404</span>
            </div>

            <article class="not-found__content">
                <p class="not-found__quote">
                    Estos no son los droides que buscas.
                </p>
                <h1 class="not-found__title">Página no encontrada</h1>
                <p class="not-found__text">
                    Los Rebeldes borraron este enlace del Registro Imperial.
                    <br />
                    La ruta que intentás acceder no existe en este sistema.
                </p>

                <div class="not-found__terminal" aria-label="Error de terminal">
                    <span class="not-found__terminal-prompt">$ </span>
                    <span class="not-found__terminal-cmd">navigate --to /</span>
                    <span class="not-found__terminal-cursor" aria-hidden="true"
                        >█</span
                    >
                </div>

                <a href="/" class="not-found__link">
                    <span class="not-found__link-text">Volvamos al sistema</span
                    >
                    <span class="not-found__link-icon" aria-hidden="true"
                        >→</span
                    >
                </a>
            </article>
        </div>
    </section>
</Layout>

<style>
    .not-found {
        position: relative;
        min-height: 100dvh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #000;
        overflow: hidden;
        font-family: "Onest Variable", sans-serif;
    }

    .not-found__scanlines {
        position: absolute;
        inset: 0;
        z-index: 1;
        pointer-events: none;
        background: repeating-linear-gradient(
            to bottom,
            transparent 0px,
            transparent 3px,
            rgba(255, 255, 255, 0.018) 3px,
            rgba(255, 255, 255, 0.018) 4px
        );
        animation: scanlines-move 8s linear infinite;
    }

    @keyframes scanlines-move {
        0% {
            background-position: 0 0;
        }
        100% {
            background-position: 0 100vh;
        }
    }

    .not-found::before {
        content: "";
        position: absolute;
        inset: 0;
        background:
            radial-gradient(
                ellipse 60% 40% at 20% 20%,
                rgba(102, 51, 153, 0.35) 0%,
                transparent 70%
            ),
            radial-gradient(
                ellipse 50% 50% at 80% 80%,
                rgba(232, 75, 60, 0.2) 0%,
                transparent 70%
            ),
            radial-gradient(
                ellipse 40% 30% at 60% 10%,
                rgba(136, 0, 255, 0.15) 0%,
                transparent 60%
            );
        pointer-events: none;
    }

    .not-found__container {
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 1.5rem;
        padding: 2rem 1.5rem;
        max-width: 700px;
        width: 100%;
    }

    .not-found__glitch-wrapper {
        line-height: 1;
        user-select: none;
    }

    .not-found__glitch {
        display: block;
        font-size: clamp(6rem, 22vw, 14rem);
        font-weight: 900;
        letter-spacing: -0.04em;
        color: #fff;
        position: relative;

        background: linear-gradient(
            135deg,
            #bc97d2 0%,
            #663399 40%,
            #e84b3c 100%
        );
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;

        animation: glitch-main 3.5s infinite;
    }

    .not-found__glitch::before,
    .not-found__glitch::after {
        content: attr(data-text);
        position: absolute;
        inset: 0;
        background: inherit;
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .not-found__glitch::before {
        left: 2px;
        text-shadow: none;
        clip-path: polygon(0 20%, 100% 20%, 100% 35%, 0 35%);
        animation: glitch-top 3.5s infinite;
        filter: hue-rotate(60deg);
    }

    .not-found__glitch::after {
        left: -2px;
        clip-path: polygon(0 65%, 100% 65%, 100% 80%, 0 80%);
        animation: glitch-bottom 3.5s infinite;
        filter: hue-rotate(-60deg);
    }

    @keyframes glitch-main {
        0%,
        90%,
        100% {
            transform: translate(0);
        }
        91% {
            transform: translate(-2px, 1px);
        }
        93% {
            transform: translate(2px, -1px);
        }
        95% {
            transform: translate(-1px, 2px);
        }
        97% {
            transform: translate(1px, -2px);
        }
    }

    @keyframes glitch-top {
        0%,
        88%,
        100% {
            transform: translate(0);
            opacity: 0;
        }
        89% {
            transform: translate(-3px, 0);
            opacity: 0.9;
        }
        91% {
            transform: translate(3px, 0);
            opacity: 0.9;
        }
        93% {
            opacity: 0;
        }
    }

    @keyframes glitch-bottom {
        0%,
        88%,
        100% {
            transform: translate(0);
            opacity: 0;
        }
        90% {
            transform: translate(3px, 0);
            opacity: 0.8;
        }
        92% {
            transform: translate(-3px, 0);
            opacity: 0.8;
        }
        94% {
            opacity: 0;
        }
    }

    .not-found__content {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.25rem;
    }

    .not-found__quote {
        font-size: clamp(0.85rem, 2vw, 1.05rem);
        color: #bc97d2;
        font-style: italic;
        letter-spacing: 0.03em;
        opacity: 0.85;
    }

    .not-found__title {
        font-size: clamp(1.4rem, 4vw, 2.2rem);
        font-weight: 700;
        color: #ececec;
        margin: 0;
        letter-spacing: -0.02em;
    }

    .not-found__text {
        font-size: clamp(0.85rem, 2vw, 1rem);
        color: rgba(236, 236, 236, 0.6);
        line-height: 1.7;
        max-width: 480px;
    }

    .not-found__terminal {
        font-family: "Courier New", Courier, monospace;
        font-size: clamp(0.8rem, 1.8vw, 0.95rem);
        color: #3be477;
        background: rgba(59, 228, 119, 0.07);
        border: 1px solid rgba(59, 228, 119, 0.2);
        border-radius: 0.5rem;
        padding: 0.6rem 1.2rem;
        letter-spacing: 0.05em;
        white-space: nowrap;
    }

    .not-found__terminal-prompt {
        color: #663399;
        font-weight: 700;
    }

    .not-found__terminal-cmd {
        color: #ececec;
    }

    .not-found__terminal-cursor {
        animation: cursor-blink 1s step-end infinite;
        color: #3be477;
        margin-left: 2px;
    }

    @keyframes cursor-blink {
        0%,
        100% {
            opacity: 1;
        }
        50% {
            opacity: 0;
        }
    }

    .not-found__link {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.75rem 2rem;
        border-radius: 0.5rem;
        font-size: clamp(0.9rem, 2vw, 1rem);
        font-weight: 600;
        letter-spacing: 0.02em;
        color: #ececec;
        background: linear-gradient(135deg, #663399, #e84b3c);
        position: relative;
        overflow: hidden;
        transition:
            transform 0.25s ease,
            box-shadow 0.25s ease;
        text-decoration: none;

        &::before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(
                120deg,
                transparent 30%,
                rgba(255, 255, 255, 0.15) 50%,
                transparent 70%
            );
            transform: translateX(-100%);
            transition: transform 0.45s ease;
        }

        &:hover {
            transform: translateY(-2px);
            box-shadow:
                0 0 24px rgba(102, 51, 153, 0.6),
                0 0 40px rgba(232, 75, 60, 0.25);
        }

        &:hover::before {
            transform: translateX(100%);
        }

        &:focus-visible {
            outline: 2px solid #bc97d2;
            outline-offset: 3px;
        }
    }

    .not-found__link-icon {
        font-size: 1.2em;
        transition: transform 0.25s ease;
    }

    .not-found__link:hover .not-found__link-icon {
        transform: translateX(4px);
    }

    @media (max-width: 480px) {
        .not-found__terminal {
            white-space: normal;
            word-break: break-all;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .not-found__glitch,
        .not-found__glitch::before,
        .not-found__glitch::after,
        .not-found__scanlines,
        .not-found__terminal-cursor {
            animation: none;
        }
    }
</style>
